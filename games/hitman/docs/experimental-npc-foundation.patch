+    CHECK(!f.peers[3]->Report(55));
+    f.worlds[3].resume=true; f.peers[3]->RetryPending();
+    CHECK(f.worlds[3].running[55]); CHECK(f.worlds[3].resumes==1);
+    REQUIRE(f.peers[3]->Report(55)); f.Pump();
+    CHECK(f.host.Find(55)->confirmed);
