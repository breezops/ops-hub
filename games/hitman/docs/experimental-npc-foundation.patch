+#include "coop/PartyReplayClient.h"
+#include <Windows.h>
+#include <chrono>
+#include <cstdio>
+#include <vector>
+
+namespace {
+volatile LONG stopping=0;
+BOOL WINAPI Stop(DWORD signal) {
+    if(signal==CTRL_C_EVENT || signal==CTRL_BREAK_EVENT || signal==CTRL_CLOSE_EVENT) { InterlockedExchange(&stopping,1); return TRUE; }
+    return FALSE;
+}
+double Now() { return std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count(); }
+}
+int main(int argc,char** argv) {
+    std::puts("HITMAN Co-op replay lab - synthetic avatar slots, not real game instances.");
+    std::puts("For the frozen 0.13.94-four-player.preview.1 / party protocol 2 only.");
+    if(argc<2 || argc>3) {
+        std::puts("Usage: HITMAN-Coop-Replay-Lab.exe HOST_ADDRESS [1_or_2_bots]");
+        std::puts("Use 127.0.0.1 when running on the host PC. Press Ctrl+C to leave.");
+        return 1;
+    }
+    const int count=argc==3 ? (std::string(argv[2])=="1"?1:std::string(argv[2])=="2"?2:0):2;
+    if(!count) { std::puts("Choose 1 or 2 synthetic slots."); return 1; }
+    std::string error; coop::Endpoint host;
+    if(!coop::ResolveEndpoint(argv[1],47047,host,error)) { std::puts("Could not resolve the host address."); return 1; }
+    SetConsoleCtrlHandler(Stop,TRUE);
+    std::vector<std::unique_ptr<coop::PartyReplayClient>> bots;
+    for(int i=0;i<count;++i) {
+        auto socket=coop::UdpSocket::Open(0,error);
+        if(!socket) { std::puts("Could not open a UDP socket."); return 1; }
+        coop::PartyRoomConfig config;
+        config.protocol=2; config.build="0.13.94-four-player.preview.1"; config.game="3.290.1";
+        config.name="[LAB BOT "+std::to_string(i+1)+"]";
+        auto room=coop::PartyRoom::Join(std::move(socket),host,config,Now());
+        if(!room) { std::puts("Could not create replay participant."); return 1; }
+        bots.push_back(std::make_unique<coop::PartyReplayClient>(std::move(room),coop::Vec3{i==0?1.2f:-1.2f,0,0}));
+    }
+    std::puts("Host your Preview 1 room, then keep this console open.");
+    std::puts("LAB BOT slots copy the host after Start preview. No NPCs/actions are simulated.");
+    double next=0;
+    while(!InterlockedCompareExchange(&stopping,0,0)) {
+        const double now=Now();
+        for(auto& bot:bots) bot->Tick(now);
+        if(now>=next) {
+            next=now+2.;
+            for(size_t i=0;i<bots.size();++i) {
+                const auto& status=bots[i]->Status();
+                std::printf("LAB BOT %zu: slot %u / state %u / mirrored %llu packets / %s\n",i+1,unsigned(status.self),unsigned(status.state),
+                    static_cast<unsigned long long>(bots[i]->Forwarded()),status.message.c_str());
+            }
+        }
+        Sleep(10);
+    }
+    for(auto& bot:bots) bot->Leave(Now());
+    const double end=Now()+1.;
+    while(Now()<end) { for(auto& bot:bots) bot->Tick(Now()); Sleep(10); }
+    return 0;
+}
