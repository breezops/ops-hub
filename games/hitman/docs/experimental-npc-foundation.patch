+#include "coop/PartyPreviewRuntime.h"
+#include "FakeWorld.h"
+#include <Windows.h>
+#include <fstream>
+#include <chrono>
+
+using namespace coop;
+namespace {
+double Now() { return std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count(); }
+struct Sink:IPartyAvatarWorld {
+    std::map<uint8_t,Transform> avatars;
+    std::map<uint8_t,Pose> poses;
+    std::map<uint8_t,OutfitDesc> outfits;
+    bool ApplyPartyRoster(const PartyRoomStatus&) override { return true; }
+    bool ShowPartyAvatar(uint8_t id,uint64_t,uint32_t,const Transform& xf) override { avatars[id]=xf; return true; }
+    bool ShowPartyPose(uint8_t id,uint64_t,uint32_t,const Pose& pose) override { poses[id]=pose; return true; }
+    bool SetPartyOutfit(uint8_t id,uint64_t,uint32_t,const OutfitDesc& outfit) override { outfits[id]=outfit; return true; }
+    bool SetPartySkeleton(uint8_t,uint64_t,uint32_t,const std::vector<int16_t>&) override { return true; }
+    bool HidePartyAvatar(uint8_t id,uint64_t,uint32_t) override { avatars.erase(id); return true; }
+    void HidePartyAvatars() override { avatars.clear(); }
+};
+}
+int main(int argc,char** argv) {
+    if(argc!=3) return 1;
+    std::string error;
+    auto socket=UdpSocket::Open(0,error); if(!socket) return 2;
+    const Endpoint endpoint{0x7f000001,socket->LocalPort()};
+    auto guestSocket=UdpSocket::Open(0,error); if(!guestSocket) return 3;
+    PartyRoomConfig config;
+    config.protocol=2; config.build="0.13.94-four-player.preview.1"; config.game="3.290.1";
+    config.name="Simulated host";
+    auto host=PartyRoom::Host(std::move(socket),config);
+    config.name="Simulated guest";
+    auto guest=PartyRoom::Join(std::move(guestSocket),endpoint,config,Now());
+    if(!host || !guest) return 4;
+    std::array<FakeWorld,2> worlds{FakeWorld("Host"),FakeWorld("Guest")};
+    std::array<Sink,2> sinks;
+    for(auto& world:worlds) {
+        world.inScene=true; world.scene.scene="assembly:/_PRO/Scenes/Missions/TheFacility/_Scene_Mission_Polarbear_Module_002_B.entity";
+        world.player.pos.x=10.f; world.pose.rotations.resize(2); world.pose.rootPos.x=1.f; world.skeleton={-1,0};
+    }
+    PartyPreviewRuntime hostRuntime(std::move(host),worlds[0],sinks[0]);
+    PartyPreviewRuntime guestRuntime(std::move(guest),worlds[1],sinks[1]);
+    std::ofstream(argv[1])<<"127.0.0.1:"<<endpoint.port;
+    const double end=Now()+20.; double readyAt=0;
+    while(Now()<end) {
+        const double now=Now(); hostRuntime.Tick(now); guestRuntime.Tick(now);
+        if(now>=readyAt && hostRuntime.Status().members.size()==4) {
+            readyAt=now+0.5;
+            if(!hostRuntime.LocalReady()) hostRuntime.Ready();
+            if(!guestRuntime.LocalReady()) guestRuntime.Ready();
+            bool all=true; for(const auto& member:hostRuntime.Status().members) all=all && member.ready;
+            if(all && hostRuntime.Status().phase==LobbyRoster::Phase::Lobby) hostRuntime.Start();
+        }
+        size_t mirrored=0;
+        if(hostRuntime.Status().phase==LobbyRoster::Phase::Playing) {
+            for(const auto& member:hostRuntime.Status().members) {
+                if(member.name.find("[LAB BOT ")!=0) continue;
+                bool valid=true;
+                for(const auto& sink:sinks) {
+                    auto position=sink.avatars.find(member.id); auto pose=sink.poses.find(member.id); auto outfit=sink.outfits.find(member.id);
+                    valid=valid && position!=sink.avatars.end() && pose!=sink.poses.end() && outfit!=sink.outfits.end();
+                    if(position!=sink.avatars.end()) valid=valid && std::fabs(std::fabs(position->second.pos.x-10.f)-1.2f)<0.001f;
+                    if(pose!=sink.poses.end()) valid=valid && pose->second.rootPos.x==1.f;
+                    if(outfit!=sink.outfits.end()) valid=valid && outfit->second==worlds[0].outfit;
+                }
+                mirrored+=valid;
+            }
+        }
+        if(mirrored==2) {
+            std::ofstream(argv[2])<<"PASS: built replay EXE joined two actual localhost UDP participants; both simulated game sinks received two correctly offset poses/outfits. No HITMAN process used.\n";
+            return 0;
+        }
+        Sleep(5);
+    }
+    std::ofstream(argv[2])<<"FAIL: replay CLI integration timed out.\n";
+    return 5;
+}
