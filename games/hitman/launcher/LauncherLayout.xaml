<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#0B0C0E" TextElement.Foreground="#F3F3F1" TextElement.FontFamily="Segoe UI">
 <Grid.Resources>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#212225"/><Setter Property="Foreground" Value="#F3F3F1"/>
   <Setter Property="BorderBrush" Value="#323337"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="18,12"/><Setter Property="Margin" Value="0,0,8,8"/>
   <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#C8102E"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#F3F3F1"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#0B0C0E"/><Setter Property="Foreground" Value="#F3F3F1"/><Setter Property="BorderBrush" Value="#323337"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12"/><Setter Property="FontSize" Value="14"/><Setter Property="CaretBrush" Value="#C8102E"/><Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#C8102E"/></Trigger></Style.Triggers></Style>
 </Grid.Resources>
 <Grid Margin="34,25,34,24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,25">
   <StackPanel><TextBlock Text="OPS HUB   /   HITMAN" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="COOPERATIVE OPERATIONS" FontSize="10" Foreground="#898B90" Margin="0,7,0,0"/></StackPanel>
   <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><TextBlock x:Name="UpdateState" Text="HITMAN release channel" VerticalAlignment="Center" Foreground="#898B90" FontSize="11" Margin="0,0,18,8" MaxWidth="240"/><Button x:Name="Updates" Content="CHECK FOR UPDATES" Margin="0,0,0,8" Padding="15,10"/></StackPanel>
  </Grid>
  <Grid Grid.Row="1" Margin="0,0,0,25">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
   <StackPanel><Rectangle Fill="#C8102E" Height="3" Width="44" HorizontalAlignment="Left" Margin="0,0,0,14"/><TextBlock Text="HITMAN / CO-OP" FontFamily="Bahnschrift SemiCondensed, Segoe UI" FontSize="46" FontWeight="Bold"/><TextBlock Text="ONE MISSION. YOUR TEAM." FontSize="12" Foreground="#898B90" Margin="1,8,0,0"/></StackPanel>
   <Border Grid.Column="1" BorderBrush="#323337" BorderThickness="1" Background="#161719" Padding="18">
    <Grid>
     <Canvas ClipToBounds="True" Opacity="0.18"><Path Stroke="#898B90" StrokeThickness="1" Data="M 120,130 L 120,48 220,10 270,22 270,130 M 120,48 L 168,63 270,22 M 168,63 L 168,130 M 132,58 L 132,130 M 144,62 L 144,130 M 156,66 L 156,130 M 184,58 L 184,130 M 201,51 L 201,130 M 218,44 L 218,130 M 235,37 L 235,130 M 252,30 L 252,130 M 0,110 L 270,110 M 0,118 L 270,118"/></Canvas>
     <StackPanel><TextBlock Text="CURRENT FIELD TEST" Foreground="#898B90" FontSize="10"/><TextBlock Text="FREEFORM&#10;TRAINING" FontWeight="SemiBold" FontSize="23" Margin="0,9,0,9"/><TextBlock Text="ICA FACILITY   /   04 AGENT CAPACITY" Foreground="#898B90" FontSize="10"/></StackPanel>
    </Grid>
   </Border>
  </Grid>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="#161719" BorderBrush="#323337" BorderThickness="1" Padding="21" Margin="0,0,0,16"><StackPanel>
     <TextBlock Text="01   /   ESTABLISH CONNECTION" FontSize="10" Foreground="#898B90" Margin="0,0,0,15"/>
     <TextBlock x:Name="State" Text="Start HITMAN to connect" FontSize="22" FontWeight="SemiBold"/>
     <TextBlock x:Name="Detail" Text="This launcher connects to one running game on this PC." Foreground="#898B90" FontSize="12" Margin="0,7,0,16"/>
     <WrapPanel><Button x:Name="Launch" Content="LAUNCH HITMAN" Background="#C8102E" BorderBrush="#C8102E"/><Button x:Name="Host" Content="HOST SESSION"/><Button x:Name="Leave" Content="LEAVE"/></WrapPanel>
     <TextBlock Text="HOST ADDRESS" Foreground="#898B90" FontSize="10" Margin="0,10,0,7"/>
     <DockPanel><Button x:Name="Join" Content="JOIN SESSION" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="Address" ToolTip="Enter the host's public IP address or hostname"/></DockPanel>
    </StackPanel></Border>
    <Border Grid.Row="1" BorderBrush="#323337" BorderThickness="1" Padding="21"><StackPanel>
     <TextBlock Text="02   /   PREPARE TO DEPLOY" Foreground="#898B90" FontSize="10" Margin="0,0,0,13"/>
     <TextBlock x:Name="Mission" Text="Load Freeform Training from HITMAN's menu on every PC." FontSize="13" Margin="0,0,0,15"/>
     <WrapPanel><Button x:Name="Ready" Content="I'M READY"/><Button x:Name="Start" Content="START PREVIEW" Background="#C8102E" BorderBrush="#C8102E"/><Button x:Name="Stop" Content="STOP PREVIEW"/><Button x:Name="Reconnect" Content="RECONNECT"/></WrapPanel>
     <TextBlock Text="Everyone readies. The host starts. Keep the launcher open while playing." Foreground="#898B90" FontSize="11" Margin="0,6,0,0"/>
    </StackPanel></Border>
   </Grid>
   <Border Grid.Column="2" Background="#161719" BorderBrush="#323337" BorderThickness="1" Padding="21"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="SQUAD ROSTER" FontSize="10" Foreground="#898B90"/><Rectangle Height="1" Fill="#323337" Margin="0,16,0,19"/></StackPanel>
    <TextBlock x:Name="Roster" Grid.Row="1" Text="0 / 4 players&#10;&#10;Host a session or join a friend." FontSize="13" LineHeight="23"/>
    <StackPanel Grid.Row="2"><Rectangle Height="2" Fill="#C8102E" Width="30" HorizontalAlignment="Left" Margin="0,0,0,14"/><TextBlock Text="MOVEMENT PREVIEW" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="Movement and disguises are shared. NPCs, items, objectives and exits run separately on each PC." Foreground="#898B90" FontSize="12" Margin="0,8,0,0"/></StackPanel>
   </Grid></Border>
  </Grid>
  <Grid Grid.Row="3" Margin="0,20,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock x:Name="Feedback" Text="Use the same mod release on every PC." FontSize="12" MinHeight="32" Margin="0,0,0,10"/>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center"><TextBlock x:Name="Release" Text="LAUNCHER 0.1.0" Foreground="#898B90" FontSize="10"/><TextBlock Text="UDP 47047   /   CLOSE HITMAN BEFORE UPDATING" Foreground="#898B90" FontSize="10" Margin="0,5,0,0"/></StackPanel>
    <WrapPanel Grid.Column="1"><Button x:Name="Repair" Content="INSTALL / REPAIR" Padding="12,9"/><Button x:Name="Remove" Content="REMOVE MOD" Padding="12,9" Margin="0,0,0,8"/></WrapPanel>
   </Grid>
  </Grid>
 </Grid>
</Grid>
